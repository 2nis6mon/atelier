{
  "name": "atelier",
  "productName": "Atelier",
  "version": "1.0.0",
  "description": "Atelier — a personal macOS workspace for your CVs, experience library and job applications.",
  "author": "Atelier",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/main/index.cjs",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:renderer": "vite build",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node scripts/run-vitest.mjs run",
    "test:coverage": "node scripts/run-vitest.mjs run --coverage",
    "test:e2e": "npm run build && playwright test",
    "fixtures": "node scripts/make-fixtures.mjs",
    "dist:mac": "npm run build && electron-builder --mac --arm64 --publish never",
    "postinstall": "node scripts/ensure-electron.mjs"
  },
  "dependencies": {
    "pdfjs-dist": "6.3.289"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/lora": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@playwright/test": "1.63.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/fra": "1.0.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.3",
    "diff": "9.0.0",
    "docx": "9.8.1",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "jsdom": "30.1.1",
    "mammoth": "1.13.0",
    "pdf-lib": "1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tesseract.js": "7.0.0",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.3",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  }
}
